# Copy this file to .env and adjust values for your environment.
# These are local development credentials — never use them in production.
#
# Host ports are intentionally non-default (5544/6399 instead of 5432/6379)
# to avoid clashing with locally installed PostgreSQL/Redis services.

POSTGRES_USER=opspulse
POSTGRES_PASSWORD=opspulse_dev
POSTGRES_DB=opspulse
